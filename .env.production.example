# Exact public frontend origin, without a trailing slash or path.
# Replace this with your production Vercel URL or custom frontend domain.
APP_ORIGIN=https://your-project.vercel.app

# Set these to the output of `id -u` and `id -g` on the VPS so the
# container can write to the data/ directory created by your VPS user.
APP_UID=1000
APP_GID=1000
